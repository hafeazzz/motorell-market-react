# ============================================================
# Template SECRET untuk workflow "DB Backup" (.github/workflows/backup.yml).
#
# INI BUKAN .env lokal. Nilai-nilai ini ditambahkan sebagai REPOSITORY SECRETS di:
#   GitHub repo → Settings → Secrets and variables → Actions → New repository secret
# Jangan pernah commit nilai aslinya.
# ============================================================

# --- WAJIB ---

# Connection string Postgres. HARUS pakai "Session Pooler" (IPv4, port 5432),
# BUKAN direct connection (db.<ref>.supabase.co — IPv6-only, tak jalan di runner
# GitHub) dan BUKAN transaction pooler (port 6543 — tidak kompatibel pg_dump).
# Ambil di: Supabase Dashboard → Project Settings → Database → Connection string
#           → tab "Session pooler" → URI.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Passphrase enkripsi backup (AES-256). Buat acak & panjang, simpan aman —
# TANPA ini backup tidak bisa di-restore. Contoh bikin: `openssl rand -base64 32`
BACKUP_PASSPHRASE=ganti-dengan-passphrase-acak-panjang

# --- OPSIONAL: notifikasi email saat backup GAGAL ---
# (kalau dikosongkan, step email dilewati; GitHub tetap kirim email kegagalan
#  scheduled workflow ke pemilik repo secara default)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=akunmu@gmail.com
MAIL_PASSWORD=app-password-16-digit   # Gmail: buat "App Password", bukan password akun
MAIL_TO=tujuan-notif@email.com
